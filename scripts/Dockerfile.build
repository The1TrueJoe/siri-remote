# Build environment for aarch64 Linux (Raspberry Pi). On Apple Silicon this
# runs natively, so it is far faster than compiling on the Pi itself.
FROM rust:slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      libdbus-1-dev libopus-dev libspeex-dev pkg-config ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /w
